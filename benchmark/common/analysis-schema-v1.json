{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cbchoi/gorti/blob/main/benchmark/common/analysis-schema-v1.json",
  "title": "DEVStone-HLA benchmark analysis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "analysis_schema_version",
    "source_schema_version",
    "source_sha256",
    "experiment_id",
    "benchmark",
    "bootstrap",
    "implementations",
    "design_checks",
    "metrics"
  ],
  "properties": {
    "analysis_schema_version": { "const": "gorti.benchmark.analysis/v1" },
    "source_schema_version": { "const": "gorti.benchmark.results/v1" },
    "source_sha256": { "$ref": "#/$defs/sha256" },
    "experiment_id": { "$ref": "#/$defs/identifier" },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "profile", "configuration_sha256"],
      "properties": {
        "name": { "const": "DEVStone-HLA" },
        "version": { "type": "string" },
        "profile": { "type": "string" },
        "configuration_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "confidence_level", "resamples", "seed", "prng", "quantile_method", "paired_resampling"],
      "properties": {
        "method": { "const": "percentile-bootstrap" },
        "confidence_level": { "const": 0.95 },
        "resamples": { "type": "integer", "minimum": 100 },
        "seed": { "type": "integer", "minimum": 0 },
        "prng": { "const": "splitmix64" },
        "quantile_method": { "const": "linear-r7" },
        "paired_resampling": { "const": "stratified-by-execution-order" }
      }
    },
    "implementations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "version"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "label": { "type": "string" },
          "version": { "type": "string" }
        }
      }
    },
    "design_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runs_per_implementation", "paired_runs", "baseline_first_pairs", "candidate_first_pairs", "fresh_process_per_run", "balanced_order"],
      "properties": {
        "runs_per_implementation": { "const": 30 },
        "paired_runs": { "const": 30 },
        "baseline_first_pairs": { "const": 15 },
        "candidate_first_pairs": { "const": 15 },
        "fresh_process_per_run": { "const": true },
        "balanced_order": { "const": true }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/metricAnalysis" }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "ci": {
      "type": "object",
      "additionalProperties": false,
      "required": ["low", "high"],
      "properties": {
        "low": { "type": "number" },
        "high": { "type": "number" }
      }
    },
    "statistic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["estimate", "ci95"],
      "properties": {
        "estimate": { "type": "number" },
        "ci95": { "$ref": "#/$defs/ci" }
      }
    },
    "nullableStatistic": {
      "oneOf": [
        { "$ref": "#/$defs/statistic" },
        { "type": "null" }
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "n", "median", "p95", "p99"],
      "properties": {
        "implementation": { "$ref": "#/$defs/identifier" },
        "n": { "const": 30 },
        "median": { "$ref": "#/$defs/statistic" },
        "p95": { "$ref": "#/$defs/statistic" },
        "p99": { "$ref": "#/$defs/statistic" }
      }
    },
    "stratum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_implementation", "n_pairs", "median_difference", "median_ratio"],
      "properties": {
        "first_implementation": { "$ref": "#/$defs/identifier" },
        "n_pairs": { "const": 15 },
        "median_difference": { "type": "number" },
        "median_ratio": {
          "oneOf": [{ "type": "number" }, { "type": "null" }]
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline",
        "candidate",
        "n_pairs",
        "difference_definition",
        "ratio_definition",
        "median_difference",
        "median_ratio",
        "order_adjusted_median_difference",
        "order_adjusted_median_ratio",
        "order_strata"
      ],
      "properties": {
        "baseline": { "$ref": "#/$defs/identifier" },
        "candidate": { "$ref": "#/$defs/identifier" },
        "n_pairs": { "const": 30 },
        "difference_definition": { "const": "candidate-minus-baseline" },
        "ratio_definition": { "const": "candidate-divided-by-baseline" },
        "median_difference": { "$ref": "#/$defs/statistic" },
        "median_ratio": { "$ref": "#/$defs/nullableStatistic" },
        "order_adjusted_median_difference": { "$ref": "#/$defs/statistic" },
        "order_adjusted_median_ratio": { "$ref": "#/$defs/nullableStatistic" },
        "order_strata": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/stratum" }
        }
      }
    },
    "metricAnalysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "unit", "direction", "summaries", "comparison"],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string" },
        "unit": { "type": "string" },
        "direction": { "enum": ["lower-is-better", "higher-is-better"] },
        "summaries": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/summary" }
        },
        "comparison": { "$ref": "#/$defs/comparison" }
      }
    }
  }
}
