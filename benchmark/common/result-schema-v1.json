{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cbchoi/gorti/blob/main/benchmark/common/result-schema-v1.json",
  "title": "DEVStone-HLA paired benchmark result",
  "description": "Structured measurements and semantic evidence for a 30-run, two-implementation DEVStone-HLA comparison.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark",
    "experiment",
    "environment",
    "implementations",
    "metrics",
    "runs"
  ],
  "properties": {
    "schema_version": {
      "const": "gorti.benchmark.results/v1"
    },
    "benchmark": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "profile", "configuration_sha256"],
      "properties": {
        "name": { "const": "DEVStone-HLA" },
        "version": { "type": "string", "minLength": 1, "maxLength": 64 },
        "profile": { "type": "string", "minLength": 1, "maxLength": 128 },
        "configuration_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "experiment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "created_at",
        "design",
        "runs_per_implementation",
        "warmup_runs",
        "base_seed",
        "fom_sha256",
        "completion_boundary",
        "process_model"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/identifier" },
        "created_at": { "type": "string", "format": "date-time" },
        "design": { "const": "paired-balanced-ab-ba" },
        "runs_per_implementation": { "const": 30 },
        "warmup_runs": { "type": "integer", "minimum": 0 },
        "base_seed": { "type": "integer", "minimum": 0 },
        "fom_sha256": { "$ref": "#/$defs/sha256" },
        "completion_boundary": { "type": "string", "minLength": 1, "maxLength": 256 },
        "process_model": { "const": "fresh-process-per-run" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host_id", "os", "cpu", "logical_cores", "memory_bytes", "python_version"],
      "properties": {
        "host_id": { "$ref": "#/$defs/identifier" },
        "os": { "type": "string", "minLength": 1, "maxLength": 256 },
        "cpu": { "type": "string", "minLength": 1, "maxLength": 256 },
        "logical_cores": { "type": "integer", "minimum": 1 },
        "memory_bytes": { "type": "integer", "minimum": 1 },
        "python_version": { "type": "string", "minLength": 1, "maxLength": 64 }
      }
    },
    "implementations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "version", "runtime", "artifact_sha256", "source_revision"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "label": { "type": "string", "minLength": 1, "maxLength": 128 },
          "version": { "type": "string", "minLength": 1, "maxLength": 128 },
          "runtime": { "type": "string", "minLength": 1, "maxLength": 128 },
          "artifact_sha256": { "$ref": "#/$defs/sha256" },
          "source_revision": { "type": "string", "minLength": 1, "maxLength": 128 }
        }
      }
    },
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "unit", "direction"],
        "properties": {
          "id": { "$ref": "#/$defs/identifier" },
          "label": { "type": "string", "minLength": 1, "maxLength": 128 },
          "unit": { "type": "string", "minLength": 1, "maxLength": 64 },
          "direction": { "enum": ["lower-is-better", "higher-is-better"] }
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 60,
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "run_id",
          "pair_id",
          "pair_index",
          "implementation",
          "position",
          "seed",
          "status",
          "measurements",
          "evidence"
        ],
        "properties": {
          "run_id": { "$ref": "#/$defs/identifier" },
          "pair_id": { "$ref": "#/$defs/identifier" },
          "pair_index": { "type": "integer", "minimum": 1, "maximum": 30 },
          "implementation": { "$ref": "#/$defs/identifier" },
          "position": { "type": "integer", "minimum": 1, "maximum": 2 },
          "seed": { "type": "integer", "minimum": 0 },
          "status": { "const": "ok" },
          "measurements": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "number",
              "minimum": 0
            }
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fom_sha256",
              "workload_sha256",
              "workload_instance_sha256",
              "expected_callbacks",
              "delivered_callbacks",
              "rejected_callbacks",
              "dropped_callbacks",
              "unexpected_callbacks",
              "duplicate_callbacks",
              "invalid_callbacks",
              "ready_synchronized",
              "start_synchronized",
              "measure_synchronized",
              "done_synchronized",
              "attribute_callback_sha256",
              "interaction_callback_sha256",
              "callback_trace_sha256",
              "terminal_state_sha256"
            ],
            "properties": {
              "fom_sha256": { "$ref": "#/$defs/sha256" },
              "workload_sha256": { "$ref": "#/$defs/sha256" },
              "workload_instance_sha256": { "$ref": "#/$defs/sha256" },
              "expected_callbacks": { "type": "integer", "minimum": 1 },
              "delivered_callbacks": { "type": "integer", "minimum": 1 },
              "rejected_callbacks": { "const": 0 },
              "dropped_callbacks": { "const": 0 },
              "unexpected_callbacks": { "const": 0 },
              "duplicate_callbacks": { "const": 0 },
              "invalid_callbacks": { "const": 0 },
              "ready_synchronized": { "const": true },
              "start_synchronized": { "const": true },
              "measure_synchronized": { "const": true },
              "done_synchronized": { "const": true },
              "attribute_callback_sha256": { "$ref": "#/$defs/sha256" },
              "interaction_callback_sha256": { "$ref": "#/$defs/sha256" },
              "callback_trace_sha256": { "$ref": "#/$defs/sha256" },
              "terminal_state_sha256": { "$ref": "#/$defs/sha256" }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]{0,63}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
