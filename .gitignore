# Go
bin/
*.test
*.out
coverage.txt
coverage.html
coverage.out

# Generated SDK proto bindings (Go bindings are committed for clean builds)
pysdk/rti1516e/_generated/
cppsdk/_generated/

# C++ SDK build artifacts (CMake out-of-source builds)
cppsdk/build/
cppsdk/build-*/
cppsdk/CMakeUserPresets.json
cppsdk/*.cmake

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
.m21-venv/
venv/
.mypy_cache/
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Editors
.vscode/
.idea/
*.swp
*~

# OS
.DS_Store
Thumbs.db

# Project-local
eventlogs/
*.local.yaml
.env
.env.*
*.pem
*.key

# Local toolchain + scratch caches. Never commit; they balloon the repo and
# are reproducible from CI.
.cache/
.tools/
.tmp/

# Sub-agent worktrees created by the Agent tool with isolation:"worktree".
# These are linked to .git/ but live as siblings on disk; never commit.
.claude/

# perf-pass profile artifacts (large binaries; reproduce locally)
docs/reports/perf/*.prof

# MkDocs build output (Read the Docs builds remotely; locally `mkdocs serve` is preferred).
/site/
/.docs-venv/

# Local verification and runtime state.
/$coverage
/Testing/
/gorti-saves/
/verification/fair-comparison/launchers.local.json

# Local sandbox tooling (Dockerfile.codex, etc.). Per-machine; never committed.
docker/
