    <name>RepeatedBranchLocalName</name>
    <type>FOM</type>
    <version>1.0</version>
    <modificationDate>2026-04-29</modificationDate>
    <securityClassification>Unclassified</securityClassification>
    <description>Distinct classes with the same local name in different branches.</description>
    <useHistory>None</useHistory>
  </modelIdentification>
  <objects>
    <objectClass>
      <name>HLAobjectRoot</name>
      <objectClass>
        <name>A</name>
