<?xml version="1.0" encoding="UTF-8"?>
<objectModel xmlns="http://standards.ieee.org/IEEE1516-2010">
  <modelIdentification>
    <name>GoRTI Java Live Exchange</name>
    <type>FOM</type>
    <version>1.0</version>
    <modificationDate>2026-09-22</modificationDate>
    <securityClassification>Unclassified</securityClassification>
    <description>Two-session public Java API object and interaction exchange.</description>
  </modelIdentification>
  <objects>
    <objectClass>
      <name>HLAobjectRoot</name>
      <sharing>Neither</sharing>
      <objectClass>
        <name>Item</name>
        <sharing>PublishSubscribe</sharing>
        <attribute>
          <name>value</name>
          <dataType>HLAinteger32BE</dataType>
          <updateType>Conditional</updateType>
          <updateCondition>On change</updateCondition>
          <ownership>NoTransfer</ownership>
          <sharing>PublishSubscribe</sharing>
          <transportation>HLAreliable</transportation>
          <order>TimeStamp</order>
          <semantics>Four manually encoded big-endian bytes.</semantics>
        </attribute>
      </objectClass>
    </objectClass>
  </objects>
  <interactions>
    <interactionClass>
      <name>HLAinteractionRoot</name>
      <sharing>Neither</sharing>
      <transportation>HLAreliable</transportation>
      <order>TimeStamp</order>
      <interactionClass>
        <name>Pulse</name>
        <sharing>PublishSubscribe</sharing>
        <transportation>HLAreliable</transportation>
        <order>TimeStamp</order>
        <semantics>An integer payload delivered by untimed or timestamped send.</semantics>
        <parameter>
          <name>payload</name>
          <dataType>HLAinteger32BE</dataType>
          <semantics>Four manually encoded big-endian bytes.</semantics>
        </parameter>
      </interactionClass>
    </interactionClass>
  </interactions>
  <switches>
    <autoProvide isEnabled="false"/>
    <conveyRegionDesignatorSets isEnabled="false"/>
    <conveyProducingFederate isEnabled="true"/>
    <attributeScopeAdvisory isEnabled="false"/>
    <attributeRelevanceAdvisory isEnabled="false"/>
    <objectClassRelevanceAdvisory isEnabled="false"/>
    <interactionRelevanceAdvisory isEnabled="false"/>
    <serviceReporting isEnabled="false"/>
    <exceptionReporting isEnabled="false"/>
    <delaySubscriptionEvaluation isEnabled="false"/>
    <automaticResignAction resignAction="CancelThenDeleteThenDivest"/>
  </switches>
</objectModel>
