# Per IEEE 1516.1-2010 §4.2, §4.9, §6.5, §6.6, §4.10:
RESERVER: CONNECT
RESERVER: JOIN
RESERVER: MULTI_RESERVE_REQUEST names=[car-X,car-Y,car-Z]
RESERVER: MULTI_RESERVED_FAILED colliding=[car-X]
RESERVER: RESIGN
# Per §6.5 the reservation is atomic: even though only car-X collides,
# car-Y and car-Z must NOT be reserved either. The colliding-names
# callback (§6.6) carries only the colliding subset, not the full
# requested set.
