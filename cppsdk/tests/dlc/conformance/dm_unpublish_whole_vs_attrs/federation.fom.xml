<?xml version="1.0" encoding="utf-8"?>
<objectModel xmlns="http://standards.ieee.org/IEEE1516-2010">
  <modelIdentification>
    <name>DLC Conformance — dm_unpublish_whole_vs_attrs</name>
    <type>FOM</type>
    <version>1.0</version>
    <description>
      Exercises both unpublishObjectClass (whole class — §5.3 / catalogue
      row 11.10 — gorti M17 lacks this entirely) and
      unpublishObjectClassAttributes (subset — §5.7). The two MUST
      produce distinct manager-side state. M31 dispatch plan §2.2
      fixture #7.
