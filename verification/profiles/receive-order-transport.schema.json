{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/cbchoi/gorti/verification/profiles/receive-order-transport.schema.json",
  "title": "gorti receive-order transport profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receive_order_transport"
  ],
  "properties": {
    "schema_version": {
      "const": "gorti.receive-order-transport/v1"
    },
    "receive_order_transport": {
      "enum": [
        "local-lrc",
        "confirmed"
      ]
    },
    "local_lrc_queue_capacity": {
      "type": "integer",
      "minimum": 1
    },
    "local_lrc_ack_every": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4294967295
    },
    "local_lrc_batch_size": {
      "enum": [
        32,
        64,
        128,
        256
      ]
    },
    "callback_representation": {
      "enum": [
        "names",
        "handles"
      ]
    }
  }
}
