{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gorti.fair-comparison/launcher-config-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "launchers"],
  "properties": {
    "schema": {"const": "gorti.fair-comparison/launcher-config-v1"},
    "launchers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pitch", "go"],
      "properties": {
        "pitch": {"$ref": "#/$defs/launcher"},
        "go": {"$ref": "#/$defs/launcher"}
      }
    }
  },
  "$defs": {
    "launcher": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "arguments", "result_file"],
      "properties": {
        "executable": {"type": "string", "minLength": 1},
        "arguments": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "result_file": {"type": "string", "minLength": 1},
        "working_directory": {"type": "string", "minLength": 1},
        "environment": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        }
      }
    }
  }
}
